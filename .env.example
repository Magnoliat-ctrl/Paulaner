# OpenAI API Configuration
# Supplier Evaluation Feature benötigt GPT-4o

# WICHTIG: API Key von https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-proj-your-actual-api-key-here

# Model für Lieferantenbewertung
# WICHTIG: gpt-5.1 existiert NICHT! Verwende gpt-4o (neuestes verfügbares Modell)
VITE_OPENAI_MODEL=gpt-4o

# Alternative Models (falls GPT-4o nicht verfügbar):
# VITE_OPENAI_MODEL=gpt-4-turbo
# VITE_OPENAI_MODEL=gpt-4
# VITE_OPENAI_MODEL=gpt-4o-mini (günstiger, aber weniger präzise)

# HINWEIS: Das Code verwendet optimierte Parameter für maximale Genauigkeit:
# - temperature: 0.1 (ultra-niedrig = sehr faktisch)
# - top_p: 0.2 (fokussiert auf wahrscheinlichste Tokens)
# - max_tokens: 4000 (erweitert für detaillierte Bewertungen)

# ANLEITUNG:
# 1. Kopiere diese Datei zu .env
# 2. Ersetze "sk-proj-your-actual-api-key-here" mit deinem echten OpenAI API Key
# 3. Starte Dev-Server neu: npm run dev
# 4. Teste die Bewertungsfunktion im Dashboard

# KOSTEN (Stand 2025):
# GPT-4o: ~$0.005 pro Bewertung (2000 tokens)
# GPT-4-turbo: ~$0.01 pro Bewertung
# GPT-4o-mini: ~$0.0003 pro Bewertung

# SICHERHEIT:
# - Commitme NIEMALS .env Datei (steht in .gitignore)
# - Teile deinen API Key mit NIEMANDEM
# - Rotiere den Key regelmäßig
